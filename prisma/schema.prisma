// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  login    String   @id
  password String
  role     String?
  teacher  Teacher? @relation(fields: [idTeach], references: [id])
  idTeach  Int?     @unique
  active   Boolean? @default(true)
}

model Student {
  id                 Int                 @id @default(autoincrement())
  firstName          String?
  lastName           String?
  birthday           DateTime?
  idenelev           String?
  classe             Class?              @relation(fields: [classId], references: [id])
  classId            Int?
  parent             Parent?             @relation(fields: [parentId], references: [id])
  parentId           Int?
  photo              String?
  status             String?
  address            String?
  phone              String?
  gender             String?
  payments           Payment[]
  absences           Absence[]
  sessionEvaluations SessionEvaluation[]
}

model Parent {
  id            Int            @id @default(autoincrement())
  name1         String?
  relation1     String?
  email1        String?
  phone1        String?
  name2         String?
  relation2     String?
  email2        String?
  phone2        String?
  childrenIds   Student[]
  username      String?
  password      String?
  active        Boolean?       @default(true)
  notifications Notification[]
}

model Payment {
  id          Int       @id @default(autoincrement())
  amount      Float?
  paymentDate DateTime? @default(now())
  as          String?
  type        String?
  student     Student?  @relation(fields: [studentId], references: [id])
  studentId   Int?
  title       String?
}

model Teacher {
  id        Int        @id @default(autoincrement())
  name      String?
  photo     String?
  iuense    String?
  email     String?
  phone     String?
  gender    String?
  diploma   String?
  classes   Class[]
  schedules Schedule[]
  user      User?
  subject   Subject?   @relation(fields: [subjectId], references: [id])
  subjectId Int?
  planings  Planing[]

  absences Absence[]
}

model Class {
  id        Int        @id @default(autoincrement())
  name      String?
  level     String?
  teachers  Teacher[]
  students  Student[]
  schedules Schedule[]
  tafs      Taf[]
  absences  Absence[]
  ressouces Ressouce[]

  planings Planing[]
}

model Room {
  id        Int        @id @default(autoincrement())
  name      String?
  type      String?
  capacity  Int?
  status    String?
  schedules Schedule[]
}

model Schedule {
  id        Int      @id @default(autoincrement())
  as        String?
  day       String?
  start     String?
  duration  Int?
  group     Boolean? @default(false)
  week      String?  @default("all")
  subject   Subject? @relation(fields: [subjectId], references: [id])
  subjectId Int?
  roomId    Int?
  room      Room?    @relation(fields: [roomId], references: [id])
  classId   Int?
  class     Class?   @relation(fields: [classId], references: [id])
  teacherId Int?
  teacher   Teacher? @relation(fields: [teacherId], references: [id])
}

model Subject {
  id          Int        @id @default(autoincrement())
  name        String?
  codematiere String?
  teachers    Teacher[]
  schedules   Schedule[]
  tafs        Taf[]
}

model Taf {
  id          Int       @id @default(autoincrement())
  subjectId   Int?
  subject     Subject?  @relation(fields: [subjectId], references: [id])
  classId     Int?
  class       Class?    @relation(fields: [classId], references: [id])
  type        String?
  dateTaf     DateTime?
  description String?
}

model Event {
  id          Int       @id @default(autoincrement())
  name        String?
  target      Int?
  dateEvent   DateTime?
  description String?
}

model Activity {
  id           Int       @id @default(autoincrement())
  nameUser     String?
  dateActivity DateTime? @default(now())
  description  String?
}

model Absence {
  id          Int       @id @default(autoincrement())
  student     Student?  @relation(fields: [studentId], references: [id])
  studentId   Int?
  classe      Class?    @relation(fields: [classId], references: [id])
  classId     Int?
  teacherId   Int?
  teacher     Teacher?  @relation(fields: [teacherId], references: [id])       
  dateAbsence DateTime?
  hour        String?
}

model Planing {
  id                 Int                 @id @default(autoincrement())
  teacherId          Int?
  teacher            Teacher?            @relation(fields: [teacherId], references: [id])
  as                 String?
  name               String?
  type               String?
  classId   Int?
  class     Class?   @relation(fields: [classId], references: [id])
  datePlaning        DateTime?
  description        String?
  ressouces          Ressouce[]
  sessionEvaluations SessionEvaluation[]
}

model SessionEvaluation {
  id        Int      @id @default(autoincrement())
  planingId Int
  planing   Planing  @relation(fields: [planingId], references: [id], onDelete: Cascade)
  studentId Int
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  note      Float // out of 10
  createdAt DateTime @default(now())

  @@unique([planingId, studentId])
}

model Ressouce {
  id        Int      @id @default(autoincrement())
  name      String?
  planingId Int?
  planing   Planing? @relation(fields: [planingId], references: [id])
  classId   Int?
  class     Class?   @relation(fields: [classId], references: [id])
}

model Notification {
  id        Int      @id @default(autoincrement())
  parentId  Int
  parent    Parent   @relation(fields: [parentId], references: [id])
  title     String
  message   String
  type      String // 'absence', 'taf', 'event'
  createdAt DateTime @default(now())
  read      Boolean  @default(false)
}

model Note {
  id             Int     @id @default(autoincrement())
  as             String?
  libperiodexam  String?
  idenelev       String?
  prenomnom      String?
  libematier     String?
  codematiere    String?
  abretypeeprear String?
  libTypeEpr     String?
  iuense         String?
  libens         String?
  libeclass      String?
  codeclass      String?
  noteepre       Float?
  codeTypeEpre   Int?
  numEpre        Int?
}
